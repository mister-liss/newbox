if has("gui_running")
    set guifont=Intel\ One\ Mono:h8
    set guioptions-=T
    if has("directx")
        set renderoptions=type:directx
    endif
    let s:geom = has("win32") ? expand("~/vimfiles/geometry.vim") : expand("~/.vim/geometry.vim")
    if filereadable(s:geom)
        execute "source" fnameescape(s:geom)
    endif
endif

"a diff gets two cells - one cannot hold two panes of real code
function! GlucDiffLook() abort
    "quiet is near-monochrome, so the only colour left on screen is the diff
    "itself. syntax highlighting and diff marking otherwise say different
    "things in the same channel on the same pixels
    silent! colorscheme quiet
    call GlucDiffColors()
    "the scheme's own ground, left alone. Lifting it off black washed the whole
    "thing out: the rest of the palette is chosen against near-black, so
    "raising only the background lowers every contrast on screen at once.
    highlight SignColumn   guibg=NONE
    highlight LineNr       guibg=NONE

    "no bars. vim needs a strip between stacked windows, so it gets one with
    "nothing written on it - a gap rather than a label. Which pane is which is
    "said by where it is
    "the scheme's own background exactly, so the strip is a gap and not a bar.
    "quiet's CursorLine is #303030 and the strips were #26262c - four bands of
    "the same weight as the one band that is supposed to say where you are.
    "The cursor line should be the brightest ground on screen and the only one.
    highlight StatusLine   guibg=#000000 guifg=#3f3f3f gui=NONE
    highlight StatusLineNC guibg=#000000 guifg=#2c2c2c gui=NONE
    highlight VertSplit    guibg=#000000 guifg=#2c2c2c gui=NONE

    "a pinstripe rather than a band. the strip is a whole row whatever we do,
    "so it gets filled with a rule: a line divides without weighing anything,
    "where a filled bar competes with the cursor line for the same job
    let &fillchars = 'vert:' . nr2char(0x2502)
        \ . ',fold:-,eob:~'
        \ . ',diff:' . nr2char(0x2508)
        \ . ',stl:' . nr2char(0x2500)
        \ . ',stlnc:' . nr2char(0x2500)
endfunction

"the changed span is bright TEXT on a dark ground, not a lit block - a white
"rectangle on a dark scheme is glare, which is the thing dark schemes avoid
function! GlucDiffColors() abort
    "no blocks anywhere - a block is what stops a line reading as a line. Which
    "lines changed is said in the gutter instead, where nothing is competing.
    "
    "Note a foreground alone cannot do this job: vim combines diff highlighting
    "with syntax and syntax wins the foreground, so DiffAdd guifg is invisible
    "on any line syntax has coloured.
    highlight DiffAdd    guibg=NONE guifg=NONE gui=NONE
    highlight DiffDelete guibg=NONE guifg=#6d4a4c gui=NONE
    highlight DiffChange guibg=NONE guifg=NONE gui=NONE
    "same background as the line it sits in, deliberately. a block around the
    "changed span gives one line two grounds, and then the line stops reading
    "as a line - the change shows and the sentence does not
    highlight DiffText   guibg=NONE guifg=#ffb454 gui=bold,underline
endfunction
call GlucDiffColors()

sign define GlucAdd    text=+  texthl=GlucSignAdd
sign define GlucChange text=~  texthl=GlucSignChange
highlight GlucSignAdd    guifg=#7fd08a guibg=NONE gui=bold
highlight GlucSignChange guifg=#ffb454 guibg=NONE gui=bold

"which lines differ, marked outside the text. asks vim what it decided rather
"than diffing again - diff_hlID is the same answer the highlighting uses
function! GlucDiffSigns() abort
    if !&diff | return | endif
    let b = bufnr()
    execute 'sign unplace * group=glucdiff buffer=' . b
    for l in range(1, line('$'))
        let n = synIDattr(diff_hlID(l, 1), 'name')
        if n ==# 'DiffAdd'
            execute 'sign place ' . l . ' group=glucdiff line=' . l . ' name=GlucAdd buffer=' . b
        elseif n ==# 'DiffChange' || n ==# 'DiffText'
            execute 'sign place ' . l . ' group=glucdiff line=' . l . ' name=GlucChange buffer=' . b
        endif
    endfor
endfunction

"Order matters, and getting it wrong leaves the window wrong: the sign column
"has to exist before the panes are balanced, or it is taken out of one of them.
"noautocmd around the walk because placing signs raises DiffUpdated, which
"walks again.
function! GlucDiffEnter() abort
    if !&diff | return | endif
    call GlucDiffLook()
    noautocmd windo setlocal signcolumn=yes
    "a merge is laid out as a diamond: base on top, ours and theirs side by
    "side beneath it, the result at the bottom. Base is off the comparison
    "axis on purpose - ours and theirs are the two things being compared and
    "you cannot compare them with a third between them, which is what every
    "tool that puts base in the middle does. Two cells wide, two tall.
    let l:merging = winnr('$') >= 4
    if exists("*GlucBand")
        call GlucBand(l:merging ? "2x2" : "2x1")
    endif
    wincmd =
    if l:merging
        "the result leaves the diff group. it carries conflict markers, so it is
        "half again as long as the three it is compared with, and vim pads the
        "short buffers to align against the long one - which lands differently
        "in each and pulls the same line onto different rows in ours and
        "theirs. Those three are the comparison and they align exactly once the
        "odd one out is not in it. The cost is :diffget, which markers replace.
        4wincmd w
        diffoff
        "base is a reference, not a candidate. it gets a glance, not a third
        "of the screen - and this has to come after the equalise
        1wincmd w
        resize 8
    endif
    call GlucDiffMark()

    "nothing written in the strip. git names these sample_BASE_1436.py and puts
    "a ruler beside it, and none of it is worth reading off a bar
    set noruler
    noautocmd windo let &l:statusline = ' '

    "the result is where you work, so that is where the cursor starts
    if l:merging | 4wincmd w | else | wincmd t | endif
endfunction

function! GlucDiffMark() abort
    if !&diff | return | endif
    let w = winnr()
    noautocmd windo call GlucDiffSigns()
    noautocmd execute w . 'wincmd w'
endfunction

augroup GlucDiff
    autocmd!
    "wincmd = because widening after the split leaves the extra columns
    "in one window instead of shared
    autocmd VimEnter    * call GlucDiffEnter()
    "deferred by a tick: walking windows inside DiffUpdated is E788, because
    "the event forbids changing buffer. a timer runs outside it
    autocmd DiffUpdated * call timer_start(10, {-> GlucDiffMark()})
augroup END

set diffopt=internal,filler,closeoff
"added one at a time: an old vim rejects the whole string over one value it
"does not know, and linematch needs 9.0.1000
silent! set diffopt+=algorithm:histogram
silent! set diffopt+=indent-heuristic
silent! set diffopt+=linematch:60
"one span per changed line. char-level marking fragments a change into a
"handful of tiny blocks, which is harder to read than one
silent! set diffopt+=inline:simple
"a light dashed rule in the filler. slashes read as content, blank reads as
"nothing at all, and this reads as a gap. nr2char so the file stays ASCII
let &fillchars = 'vert:|,fold:-,eob:~,diff:' . nr2char(0x2508)

"keep the caret in the middle half, both axes
set sidescroll=1
augroup ScrollMargins
    autocmd!
    autocmd VimEnter,VimResized * let &scrolloff = &lines / 4 | let &sidescrolloff = &columns / 4
augroup END
